DOCKER_HOST=unix:///var/run/docker.sock
TARGET_IMAGE=sandbox-target-app

# Database backend: sqlite (default) or db2
DB_PROVIDER=sqlite

# Db2 connection (required when DB_PROVIDER=db2)
# Option 1: Full DSN
DB2_DSN=
# Example: DATABASE=<db>;HOSTNAME=<host>;PORT=50000;PROTOCOL=TCPIP;UID=<user>;PWD=<pass>;Security=SSL;

# Option 2: Individual fields (used when DB2_DSN is not set)
DB2_HOST=
DB2_PORT=50000
DB2_DATABASE=
DB2_USERNAME=
DB2_PASSWORD=
DB2_SECURITY=SSL

# Optional SSL CA certificate configuration
# DB2_SSL_CA_FILE=/absolute/path/to/ca-cert.pem
DB2_SSL_CA_NAME=db2-ca.pem
DB2_SSL_CA_BASE64=

# Groq API key: drafts studio tests and drives the AI agent (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional model override
# GROQ_MODEL=openai/gpt-oss-120b

# Deepgram keys for the live mic. Leave empty to use Wispr Flow or typing instead.
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Optional: allow studio targets that are not on localhost
# QLABS_ALLOW_REMOTE_TARGETS=1

# Optional: shareable demo link (e.g. ngrok). Use {port} for the sandbox port.
# Example: https://{port}.ngrok-free.app
# SHAREABLE_SANDBOX_BASE_URL=

# Optional: base URL for QA runner self-calls (default http://127.0.0.1:8000)
# API_BASE_URL=http://127.0.0.1:8000
